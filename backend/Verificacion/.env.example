# Copia esta plantilla a un archivo .env fuera de public_html.
# Por defecto, InnHub busca el archivo un nivel por encima de la carpeta del sitio.
# Tambien puedes indicar su ruta absoluta con la variable de servidor INNHUB_ENV_PATH.

DB_HOST=localhost
DB_NAME=REEMPLAZAR_CON_NOMBRE_BASE_DATOS
DB_USER=REEMPLAZAR_CON_USUARIO_BASE_DATOS
DB_PASS=REEMPLAZAR_CON_CLAVE_BASE_DATOS

WUAPI_ACCOUNT_ID=REEMPLAZAR_CON_ID_CUENTA
WUAPI_API_KEY=REEMPLAZAR_CON_API_KEY

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=REEMPLAZAR_CON_CORREO_DEL_DOMINIO
SMTP_PASS=REEMPLAZAR_CON_CLAVE_DEL_CORREO
SMTP_SECURE=ssl
SMTP_CA_FILE=
MAIL_FROM=
MAIL_FROM_NAME=Hotel Valencia - InnHub
APP_FRONTEND_ORIGIN=https://innhub.site
APP_PUBLIC_URL=https://innhub.site/backend/Verificacion
